# Copy this file to .env and fill in your values before running the container.

# ── MongoDB Configuration ─────────────────────────────────────────────────────
# Option 1: Use local MongoDB (via docker-compose mongo service)
MONGO_DB_URI=mongodb://mongo:27017/rescuebytes

# Option 2: Use MongoDB Atlas (recommended for production)
# MONGO_DB_URI=mongodb+srv://username:password@cluster0.xxxxx.mongodb.net/rescuebytes?retryWrites=true&w=majority

# ── API Keys ──────────────────────────────────────────────────────────────────
# Google Gemini AI API Key (required for AI chat features)
# Get your key from: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# ── Security ──────────────────────────────────────────────────────────────────
# JWT / Session Secret (change to a long random string)
JWT_SECRET=change_me_to_a_long_random_string_min_32_chars

# ── Server Configuration ──────────────────────────────────────────────────────
# Node environment
NODE_ENV=production

# CORS Origin (frontend URL - update for production)
# For AWS deployment, use your EC2 public IP or domain
# Example: http://54.123.45.67 or https://yourdomain.com
CORS_ORIGIN=http://localhost:5173

# Server Port (default: 3000)
PORT=3000
